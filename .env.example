# AI model gateway used by AnalyticsBot
# Copy this file to .env.local, then replace the base URL and token.
# If the gateway URL is the same one used by Claude Code, keep the host here;
# the chatbot route will add /v1 for OpenAI-compatible chat requests.
AI_GATEWAY_BASE_URL=https://api.ai-box.vn
AI_GATEWAY_AUTH_TOKEN=replace-with-your-token
ANALYTICS_BOT_MODEL=gpt-4o-mini

# AnalyticsBot uses the local HBAAC train/submission dataset unless you wire a separate analytics backend.
ANALYTICS_BACKEND_USE_LOCAL_FALLBACK=true
